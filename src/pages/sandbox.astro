<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>shaders-js</title>
    </head>

    <body>
        <canvas id="my-shader"></canvas>
    </body>
</html>

<style>
    body {
        background-color: black;
    }
    canvas {
        width: 100%;
        height: 100vh;
        position: relative;
        z-index: 2;
    }
    h1 {
        position: absolute;
        top: 0;
        bottom: -500px;
        left: 0;
        right: 0;
        margin: auto;
        color: white;
        box-sizing: border-box;
        width: fit-content;
        height: 40px;
        font-size: 1rem;
        font-family: Inter;
        font-weight: 300;
        background-color: transparent;
        z-index: 1;
    }
</style>

<script>
    import { createShader } from "shaders/js";
    import { animate } from "motion";

    const canvas = document.getElementById("my-shader");
    const status = document.getElementById("status");

    let particleScale = 0.5;

    const shader = await createShader(
        canvas,
        {
            components: [
                /*
                {
                    type: "Particles",
                    id: "particles",
                    props: {
                        colorA: "#ffffff",
                        colorB: "#ffffff",
                        particleShape: "glow",
                        scale: particleScale,
                        size: 1.5,
                        spread: 0.5,
                        agitation: 3,
                        damping: 1,
                        mouseInfluence: 10,
                        //mouseInfluence: 10,
                        mouseRadius: 0.2,
                    },
                }
                */
                {
                    type: "Particles",
                    id: "particles",
                    props: {
                        colorA: "#ffffff",
                        colorB: "#ffffff",
                        particleShape: "glow",
                        scale: 7,
                        size: 0.1,
                        spread: 0.5,
                        agitation: 0,
                        damping: 1,
                        mouseInfluence: 0.1,
                        mouseRadius: 0.1,
                    },
                },
                /*
                {
                    type: "Text",
                    props: {
                        text: "Next-gen Digital Experiences",
                        fontFamily: "Geist Pixel",
                        fontWeight: 300,
                        fontSize: 0.15,
                        letterSpacing: -0.02,
                        width: 0.8,
                        lineHeight: 1
                    },
                },
                */
                {
                    type: "Glass",
                    props: {
                        center: {
                            type: "mouse-position",
                            smoothing: 0.12,
                            momentum: 0.2
                        },
                        edgeSoftness: 5,
                        blur: 0,
                        thickness: 2,
                        innerZoom: 1,
                        fresnel: 5,
                        shape: {
                            type: "octahedron3D",
                            sizeX: 0.27,
                            sizeY: 0.27,
                            sizeZ: 0.27,
                            rounding: 0.0,
                            rotX: 25,
                            rotY: {
                                type: "auto-animate",
                                mode: "loop",
                                outputMin: 1,
                                outputMax: 360,
                                speed: 0.5,
                            },
                            rotZ: {
                                type: "auto-animate",
                                mode: "loop",
                                outputMin: 1,
                                outputMax: 360,
                                speed: 0.5,
                            },
                        },
                    },
                },
            ],
        },
        {
            onReady: () => {},
        },
        {
            onError: (reason) => {
                status.style.color = "red";
                showFallback(reason);
            },
        },
    );

    /*
    canvas.addEventListener("click", () => {
        animate(particleScale, 7, {
            duration: 2,
            ease: "circInOut",
            onUpdate: (latest) => {
                status.textContent = latest;
                particleScale = latest;
                shader.update("particles", {
                    scale: particleScale,
                    size: 0.1,
                    mouseInfluence: 0.2,
                    agitation: 0,
                });
            },
        });
    });
    */
</script>
